{
	"schemaVersion": 1,
	"id": "jarvis",
	"version": "${version}",
	"name": "Jarvis Client Assistant",
	"description": "AI assistant in your client: answers questions, searches the web and sends commands for you.",
	"authors": ["Lennard"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["de.lennard.jarvis.JarvisMod"],
		"voicechat": ["de.lennard.jarvis.JarvisVoicechatPlugin"]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
